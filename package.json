{
  "name": "proofix",
  "version": "0.2.0",
  "description": "Production-ready Zod validators for real-world data — names, passwords, IBANs, IPs and more",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "Arif Hasanov",
    "email": "arifhesenv@gmail.com",
    "web": "https://github.com/hesenv07"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hesenv07/proofix"
  },
  "keywords": [
    "zod",
    "validation",
    "validators",
    "schema",
    "typescript",
    "email",
    "password",
    "uuid",
    "iban",
    "credit-card",
    "ssn",
    "vat",
    "postal-code",
    "ip-address",
    "phone",
    "url",
    "jwt",
    "semver",
    "cron",
    "mongodb",
    "form-validation",
    "proofix"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./string": {
      "types": "./dist/string/index.d.ts",
      "import": "./dist/string/index.js"
    },
    "./document": {
      "types": "./dist/document/index.d.ts",
      "import": "./dist/document/index.js"
    },
    "./date": {
      "types": "./dist/date/index.d.ts",
      "import": "./dist/date/index.js"
    },
    "./number": {
      "types": "./dist/number/index.d.ts",
      "import": "./dist/number/index.js"
    },
    "./network": {
      "types": "./dist/network/index.d.ts",
      "import": "./dist/network/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "zod": ">=3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "fdir": "^6.5.0",
    "globals": "^15.0.0",
    "prettier": "^3.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "zod": "^3.23.0"
  }
}
